{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "2048",
  "version": "0.1.0",
  "identifier": "com.game2048.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "appDirectoriesOverride": "./app-data",
    "windows": [
      {
        "label": "main",
        "title": "2048",
        "width": 540,
        "height": 720,
        "minWidth": 380,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#FAF8EF"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "2048",
    "shortDescription": "Offline 2048 desktop game",
    "longDescription": "A calm, offline 2048 game with autosave, history and themes.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
